<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required for Electron/Chromium's JIT under the hardened runtime that Apple notarization requires. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- TV Pro needs outbound network access to the IPTV provider and the HTTPS gateways. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- The built-in local proxy (loopback only, see src/localProxy.js) needs to bind a listening socket. -->
  <key>com.apple.security.network.server</key>
  <true/>
</dict>
</plist>
